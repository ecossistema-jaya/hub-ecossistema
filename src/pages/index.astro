---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Quick from '../components/Quick.astro';
import Worlds from '../components/Worlds.astro';
import Panorama from '../components/Panorama.astro';
import Atlas from '../components/Atlas.astro';
import Ayla from '../components/Ayla.astro';
import Tarot from '../components/Tarot.astro';
import Footer from '../components/Footer.astro';
import Topbar from '../components/Topbar.astro';

const title = 'Jaya, Entre Mundos · Inteligência Relacional';
const description =
  'Terapia de relacionamentos pelo MÉTODO: Arquitetura Relacional dos 5 Elementos™, Tarot autoral e IA explicada sem jargão. Os dois mundos de Jaya Roberta num só lugar.';
---

<Base title={title} description={description}>
  <Topbar />

  <main>
    <Hero />
    <Quick />
    <Worlds />
    <Panorama />
    <Atlas />
    <Ayla />
    <Tarot />
  </main>

  <Footer />
</Base>

