---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Quick from '../components/Quick.astro';
import Worlds from '../components/Worlds.astro';
import Panorama from '../components/Panorama.astro';
import Atlas from '../components/Atlas.astro';
import Tarot from '../components/Tarot.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';

const title = 'Jaya, Entre Mundos · Inteligência Relacional';
const description =
  'Dois territórios, uma Jaya: terapia de relacionamentos com o Método dos 5 Elementos, Tarot autoral e inteligência artificial explicada sem jargão.';
---

<Base title={title} description={description}>
  <header class="topbar">
    <div class="wrap topbar__inner">
      <a class="brand" href="/">
        <span class="brand__logo" aria-hidden="true"></span>
        <span class="brand__text">
          <span class="visually-hidden">Jaya Roberta — </span>
          <span class="brand__sub">Entre Mundos</span>
        </span>
      </a>
      <p class="topbar__motto" aria-hidden="true">Conhecimento em movimento</p>
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Alternar tema escuro">
        <Icon name="sun" size={18} class="theme-toggle__sun" />
        <Icon name="moon" size={18} class="theme-toggle__moon" />
      </button>
    </div>
  </header>

  <main>
    <Hero />
    <Quick />
    <Worlds />
    <Panorama />
    <Atlas />
    <Tarot />
  </main>

  <Footer />
</Base>

<style>
  .topbar {
    position: fixed;
    inset: 0 0 auto;
    z-index: 30;
    padding-top: env(safe-area-inset-top, 0px);
    background: color-mix(in srgb, var(--paper) 86%, transparent);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid color-mix(in srgb, var(--line) 70%, transparent);
  }
  html[data-tier='0'] .topbar {
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    background: var(--paper);
  }
  .topbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: var(--header-h);
  }
  .brand { display: flex; align-items: center; gap: 14px; min-height: 48px; }
  .brand__logo {
    width: 86px;
    height: 42px;
    background: var(--ink);
    -webkit-mask: url('/brand/logo-horizontal.webp') left center / contain no-repeat;
    mask: url('/brand/logo-horizontal.webp') left center / contain no-repeat;
  }
  .brand__text { display: flex; align-items: center; gap: 14px; }
  .brand__sub {
    display: none;
    font-family: var(--font-display);
    font-size: 0.62rem;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .brand__sub::before {
    content: '';
    display: inline-block;
    width: 34px;
    height: 1px;
    margin-right: 14px;
    vertical-align: middle;
    background: var(--sepia-3);
  }
  .topbar__motto {
    display: none;
    margin-left: auto;
    font-family: var(--font-display);
    font-size: 0.62rem;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .topbar__motto::before {
    content: '';
    display: inline-block;
    width: 60px;
    height: 1px;
    margin-right: 16px;
    vertical-align: middle;
    background: var(--rust);
  }

  .theme-toggle {
    position: relative;
    flex: none;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    overflow: hidden;
    transition: background-color var(--t-fast), color var(--t-fast);
  }
  @media (hover: hover) {
    .theme-toggle:hover { background: var(--teal); color: var(--on-teal); }
  }
  .theme-toggle :global(svg) { grid-area: 1 / 1; transition: transform 0.6s var(--ease-out), opacity 0.4s; }
  .theme-toggle :global(.theme-toggle__moon) { transform: translateY(140%) rotate(-40deg); opacity: 0; }
  :global([data-theme='dark']) .theme-toggle :global(.theme-toggle__sun) { transform: translateY(-140%) rotate(40deg); opacity: 0; }
  :global([data-theme='dark']) .theme-toggle :global(.theme-toggle__moon) { transform: none; opacity: 1; }

  @media (min-width: 700px) {
    .brand__sub { display: inline; }
  }
  @media (min-width: 1100px) {
    .topbar__motto { display: block; }
  }
</style>
