---
/* Standalone sales page for the Planner Fogo, built from ar.astro (same
   structure, CSS and interactions; not the hub Base layout). Every exercise
   name, day, week title, page count and closing line traces to
   Jaya_Hub_Page/planners/Planner Fogo Novo.pdf (42 pages, read in full with
   pymupdf) or to the checkout in links.json. The palette is the Ar/Água CSS
   with the night tones moved from navy to ember (the Fogo week art sits on a
   deep maroon) and the featured days lit in flame orange instead of cyan. */
import { DEFAULT_PIXEL_ID } from '../../data/planners';
import PlannerTrail from '../../components/PlannerTrail.astro';

const CANONICAL = 'https://plataforma.jayaroberta.com.br/planners/fogo';
const OG_IMAGE = 'https://plataforma.jayaroberta.com.br/planners/fogo-og.jpg';
const CHECKOUT = 'https://pay.hotmart.com/K104787593G';
const PIXEL_NAME = 'Planner Fogo';
const PIXEL_VALUE = 57;
const onVercel = process.env.VERCEL === '1';

const productLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Planner Fogo',
  image: OG_IMAGE,
  brand: { '@type': 'Brand', name: 'Shakti Jaya' },
  offers: {
    '@type': 'Offer',
    price: '57',
    priceCurrency: 'BRL',
    availability: 'https://schema.org/InStock',
    url: CHECKOUT,
  },
};
---

