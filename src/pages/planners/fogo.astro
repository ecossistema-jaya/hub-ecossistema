l span{font-size:8px;letter-spacing:.13em;line-height:1.5;text-transform:uppercase;margin-top:6px}.product-caption{position:absolute;bottom:0;left:0;right:0;text-align:center;color:#bfb3a1;font-size:9px;letter-spacing:.04em}.product-caption:before{content:'';height:32px;width:1px;background:#e6bf7e60;display:block;margin:0 auto 12px}.hero-bottom{position:relative;z-index:1;display:flex;justify-content:space-between;gap:26px;margin-top:44px;border-top:1px solid #ffffff1c;padding-top:24px;font-size:10px;color:#d1c9ba}.hero-bottom>div{display:flex;gap:11px;align-items:center}.hero-bottom strong{font-family:var(--serif);font-weight:400;font-size:26px;color:var(--gold);line-height:1}.hero-bottom .fine{font-size:9px;max-width:205px;text-align:right;color:#b1a48d}.scroll-note{font-size:9px;text-transform:uppercase;letter-spacing:.16em;display:flex;align-items:center;gap:12px}.scroll-note:before{content:'';height:1px;width:30px;background:#e6bf7e60}
.recognition{background:var(--paper)}.recognition-top{display:grid;grid-template-columns:1.35fr .65fr;gap:80px;align-items:end}.recognition-top>p{font-size:15px;color:var(--muted);padding-bottom:3px}.situations{display:grid;grid-template-columns:repeat(3,1fr);gap:38px;margin-top:54px}.situation{padding-top:22px;border-top:1px solid var(--line)}.situation-no{font-family:var(--serif);font-size:17px;color:var(--gold-dark);display:block;margin-bottom:16px}.situation h3{font-size:29px;margin-bottom:17px;line-height:1.15}.situation p{font-size:13px;color:var(--muted);line-height:1.8}.gentle-line{display:flex;gap:28px;align-items:center;margin-top:54px;font-family:var(--serif);font-size:26px;color:var(--blue)}.gentle-line:before{content:'';width:55px;height:1px;background:var(--gold-dark);flex-shrink:0}
.method{background:#ede9e1;padding:85px 0}.method-intro{display:grid;grid-template-columns:1fr 1fr;align-items:end;gap:90px}.method-intro p{font-size:14px;color:var(--muted)}.elements{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin-top:42px}.element{padding:26px 18px 24px;border:1px solid #49391821;min-height:165px;position:relative;background:#ffffff1f}.element svg{width:30px;height:30px;color:#8b7760;display:block;margin-bottom:15px;stroke-width:1.15}.element h3{font-size:27px;margin-bottom:8px}.element p{font-size:11px;color:var(--muted);line-height:1.7}.element.active{background:var(--navy);color:var(--paper);border-color:var(--navy);box-shadow:0 12px 30px #3a2d121a;transform:translateY(-8px)}.element.active svg{color:var(--gold)}.element.active p{color:#d6cbb9}.element-active-label{position:absolute;right:12px;top:14px;font-size:7px;letter-spacing:.12em;color:var(--gold);text-transform:uppercase}.method-foot{display:flex;gap:25px;justify-content:space-between;align-items:flex-start;margin-top:28px}.method-foot>p{font-size:13px;max-width:730px}.method-foot>span{font-size:9px;line-height:1.7;max-width:255px;color:#7e786c}.method-foot strong{font-weight:600}
.sample{background:var(--white)}.sample-grid{display:grid;grid-template-columns:.88fr 1.12fr;gap:92px;align-items:center}.sample-description>p{font-size:14px;line-height:1.85;color:var(--muted);margin-top:24px}.sample-description .text-link{display:inline-flex;align-items:center;gap:12px;margin-top:28px;color:var(--ink)}.sample-description .eyebrow{margin-bottom:22px;color:var(--gold-dark)}.mini-steps{display:flex;gap:19px;margin-top:30px;padding-top:23px;border-top:1px solid var(--line);font-size:10px;color:var(--muted)}.mini-steps span{display:flex;align-items:center;gap:6px}.mini-steps .icon{width:16px;height:16px;color:var(--gold-dark)}.sample-frame{background:var(--paper);border:1px solid #e1d9cd;padding:15px 30px 25px;position:relative;box-shadow:0 18px 50px #3a28090a}.sample-frame:before{content:'';position:absolute;left:13px;right:13px;bottom:-8px;height:8px;background:#ece6db;border:1px solid #ded5c7;border-top:0}.sample-tabs{display:flex;gap:10px;padding-bottom:15px;border-bottom:1px solid var(--line);margin-bottom:27px}.sample-tabs button{flex:1;padding:9px 7px;border:1px solid transparent;border-radius:2px;background:transparent;color:var(--muted);font-size:10px;line-height:1.5}.sample-tabs button small{display:block;text-transform:uppercase;font-size:8px;letter-spacing:.1em}.sample-tabs button[aria-selected=true]{background:var(--navy);color:var(--paper)}.sample-panel .eyebrow{color:var(--gold-dark);font-size:8px;letter-spacing:.15em;margin-bottom:13px}.sample-panel h3{font-size:34px;margin-bottom:25px}.sample-panel blockquote{font-family:var(--serif);font-size:26px;line-height:1.35;color:var(--ink);min-height:151px}.reflection{margin-top:25px;padding-top:20px;border-top:1px solid var(--line)}.reflection span{font-size:8px;letter-spacing:.17em;color:var(--gold-dark);text-transform:uppercase}.reflection p{font-family:var(--serif);font-size:22px;margin-top:7px}.writing-lines{height:44px;margin-top:15px;background:repeating-linear-gradient(to bottom,transp