.header{position:absolute;left:0;top:0;width:100%;z-index:20;color:var(--paper)}.header-row{height:100px;border-bottom:1px solid #ffffff19;display:flex;align-items:center;justify-content:space-between;gap:24px}.wordmark{display:flex;align-items:center;gap:14px;text-decoration:none}.brand-symbol{display:block;flex:none;width:32px;height:40px;color:var(--gold);background:currentColor;-webkit-mask:url('/planners/fogo/jaya-simbolo.png') center/contain no-repeat;mask:url('/planners/fogo/jaya-simbolo.png') center/contain no-repeat}.brand-title{display:block;font-family:var(--serif);font-size:22px;line-height:1.1;letter-spacing:.14em}.brand-tag{display:block;font-size:7px;letter-spacing:.3em;color:var(--gold);margin-top:6px}.header-nav{display:flex;align-items:center;gap:30px;font-size:11px}.header-nav a{text-decoration:none}.header-nav>a:hover{color:var(--gold)}.header-nav .nav-cta{padding:10px 18px;border:1px solid #e6bf7e70;border-radius:3px;color:var(--gold)}.hero{position:relative;overflow:hidden;background:var(--navy);color:var(--paper);padding:152px 0 62px}.hero:before{content:'';position:absolute;right:-3%;top:160px;width:53%;height:570px;background:radial-gradient(ellipse,#8a2f1655,transparent 67%);pointer-events:none}.hero{background-image:linear-gradient(to bottom,transparent calc(100% - 110px),#0e050455)}.hero-grid{position:relative;z-index:1;display:grid;grid-template-columns:1.1fr .9fr;align-items:center;gap:28px}.hero .eyebrow{color:var(--gold);margin-bottom:25px;display:flex;align-items:center;gap:12px}.hero .eyebrow:before{content:'';display:block;width:24px;height:1px;background:var(--gold)}.hero h1{font-size:clamp(54px,5.2vw,74px);line-height:1.015;letter-spacing:-.045em}.hero h1 em{color:var(--gold)}.hero-copy>p{font-size:15px;max-width:480px;color:#d2cbbd;margin-top:26px;line-height:1.8}.hero-product-line{font-size:11px;line-height:1.8;color:#e6e3dc;margin-top:24px;display:flex;gap:9px;align-items:flex-start}.hero-product-line .icon{color:var(--gold);m