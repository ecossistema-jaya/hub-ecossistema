---
/* Standalone sales page for the Planner Éter, built from ar.astro (same
   structure, CSS and interactions; not the hub Base layout). Every exercise
   name, day, week title, page count and closing line traces to
   Jaya_Hub_Page/planners/Planner Éter Novo.pdf (42 pages, read in full with
   pymupdf) or to the checkout in links.json. The palette is the Ar/Água CSS
   with the night tones moved from navy to violet (the Éter week art sits on a
   violet night) and the featured days lit in lilac instead of cyan. */
import { DEFAULT_PIXEL_ID } from '../../data/planners';

const CANONICAL = 'https://plataforma.jayaroberta.com.br/planners/eter';
const OG_IMAGE = 'https://plataforma.jayaroberta.com.br/planners/eter-og.jpg';
const CHECKOUT = 'https://pay.hotmart.com/N104787660T';
const PIXEL_NAME = 'Planner Éter';
const PIXEL_VALUE = 57;
const onVercel = process.env.VERCEL === '1';

const productLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Planner Éter',
  image: OG_IMAGE,
  brand: { '@type': 'Brand', name: 'Shakti Jaya' },
  offers: {
    '@type': 'Offer',
    price: '57',
    priceCurrency: 'BRL',
    availability: 'https://schema.org/InStock',
    url: CHECKOUT,
  },
};
---

<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#1a0f2c">
<title>Planner Éter | 30 dias para redescobrir o sentido da relação, por JAYA Roberta</title>
<meta name="description" content="Vocês funcionam, mas sabem por que estão juntos? Conheça o Planner Éter: 30 dias de práticas guiadas de propósito e visão compartilhada, por JAYA Roberta.">
<link rel="canonical" href={CANONICAL} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta property="og:title" content="Nada quebra. E mesmo assim falta tudo.">
<meta property="og:description" content="Planner Éter. Um percurso de 30 dias para redescobrir por que vocês estão juntos, uma prática de cada vez.">
<meta property="og:type" content="website">
<meta property="og:locale" content="pt_BR" />
<meta property="og:site_name" content="Shakti Jaya" />
<meta property="og:url" content={CANONICAL} />
<meta property="og:image" content={OG_IMAGE} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Capa do Planner Éter, de JAYA Roberta" />
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="Nada quebra. E mesmo assim falta tudo.">
<meta name="twitter:description" content="Planner Éter. Um percurso de 30 dias para redescobrir por que vocês estão juntos, uma prática de cada vez.">
<meta name="twitter:image" content={OG_IMAGE} />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Inter:wght@400;500;600;700&display=swap">
<link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
<noscript><link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"></noscript>
<script type="application/ld+json" set:html={JSON.stringify(productLd)} />
<script is:inline define:vars={{ id: DEFAULT_PIXEL_ID, name: PIXEL_NAME, value: PIXEL_VALUE }}>
  !function(f){if(f.fbq)return;var n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[]}(window);
  fbq('init', id);
  fbq('track', 'PageView');
  fbq('track', 'ViewContent', { content_name: name, value: value, currency: 'BRL' });
  window.__plannerPixel = { name: name, value: value };
  window.addEventListener('load', function () {
    setTimeout(function () {
      var t = document.createElement('script');
      t.async = true;
      t.src = 'https://connect.facebook.net/en_US/fbevents.js';
      document.head.appendChild(t);
    }, 1500);
  });
</script>
{onVercel && <script is:inline defer src="/_vercel/insights/script.js"></script>}
{onVercel && <script is:inline defer src="/_vercel/speed-insights/script.js"></script>}
<style is:global>
/* Fallback faces sized to EB Garamond and Inter (metrics computed from the Google
   woff2 files vs Georgia/Arial), so the hero does not reflow when web fonts swap in. */
@font-face{font-family:'EB Garamond Fallback';src:local('Georgia');size-adjust:86%;ascent-override:117.09%;descent-override:34.65%;line-gap-override:0%}
@font-face{font-family:'EB Garamond Fallback';font-style:italic;src:local('Georgia Italic'),local('Georgia-Italic');size-adjust:82.63%;ascent-override:121.86%;descent-override:36.06%;line-gap-override:0%}
@font-face{font-family:'Inter Fallback';src:local('Arial');size-adjust:107.12%;ascent-override:90.44%;descent-override:22.52%;line-gap-override:0%}
@font-face{font-family:'Inter Fallback';font-weight:600 800;src:local('Arial Bold'),local('Arial-BoldMT');size-adjust:107.12%;ascent-override:90.44%;descent-override:22.52%;line-gap-override:0%}

:root{--navy:#1a0f2c;--deep:#0c0616;--blue:#3a2560;--ink:#251a36;--muted:#62587a;--paper:#f8f5ef;--white:#fffdfa;--sand:#eee8de;--gold:#e6bf7e;--gold-dark:#957044;--line:rgba(58,37,96,.15);--serif:'EB Garamond','EB Garamond Fallback',Georgia,serif;--sans:Inter,'Inter Fallback',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;--radius:6px;--width:1160px}
*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:100px}body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.7 var(--sans);-webkit-font-smoothing:antialiased}a{color:inherit;text-underline-offset:5px}button,input{font:inherit}button,a{-webkit-tap-highlight-color:transparent}button{cursor:pointer}img{display:block;max-width:100%;height:auto}svg{display:inline-block;flex-shrink:0}h1,h2,h3,p,blockquote,figure{margin:0}h1,h2,h3{font-family:var(--serif);font-weight:400;line-height:1.04;letter-spacing:-.035em}p+p{margin-top:18px}h2{font-size:clamp(39px,4.1vw,58px)}h3{font-size:30px}em{font-weight:400}::selection{background:var(--gold);color:var(--deep)}:focus-visible{outline:3px solid #8f76c9;outline-offset:6px}.wrap{width:min(var(--width),calc(100% - 96px));margin:auto}.section{padding:100px 0}.eyebrow{display:block;font-size:10px;font-weight:600;line-height:1.7;letter-spacing:.18em;text-transform:uppercase}.muted{color:var(--muted)}.section-intro{max-width:670px}.section-intro .eyebrow{margin-bottom:20px;color:var(--gold-dark)}.section-intro>p{margin-top:24px;max-width:590px;color:var(--muted)}.gold{color:var(--gold)}.center{text-align:center}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}.skip{position:fixed;top:10px;left:16px;transform:translateY(-200%);z-index:200;background:white;padding:12px 20px}.skip:focus{transform:translateY(0)}[hidden]{display:none!important}.btn{display:inline-flex;align-items:center;justify-content:center;gap:18px;min-height:58px;padding:16px 26px;border:1px solid transparent;border-radius:3px;background:var(--gold);color:var(--deep);text-decoration:none;font-size:13px;font-weight:600;line-height:1.3;transition:background .2s,transform .2s,box-shadow .2s}.btn:hover{background:#f1cd95;transform:translateY(-2px);box-shadow:0 9px 25px #0002}.btn svg{width:20px;height:20px}.btn-navy{background:var(--navy);color:white}.btn-navy:hover{background:var(--blue)}.text-link{font-size:12px;text-decoration:none;border-bottom:1px solid currentColor;padding-bottom:4px}.icon{width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}.tick{color:var(--gold-dark);width:18px;height:18px}.dark{background:var(--navy);color:var(--paper)}
.header{position:absolute;left:0;top:0;width:100%;z-index:20;color:var(--paper)}.header-row{height:100px;border-bottom:1px solid #ffffff19;display:flex;align-items:center;justify-content:space-between;gap:24px}.wordmark{display:flex;align-items:center;gap:14px;text-decoration:none}.brand-symbol{display:block;flex:none;width:32px;height:40px;color:var(--gold);background:currentColor;-webkit-mask:url('/planners/eter/jaya-simbolo.png') center/contain no-repeat;mask:url('/planners/eter/jaya-simbolo.png') center/contain no-repeat}.brand-title{display:block;font-family:var(--serif);font-size:22px;line-height:1.1;letter-spacing:.14em}.brand-tag{display:block;font-size:7px;letter-spacing:.3em;color:var(--gold);margin-top:6px}.header-nav{display:flex;align-items:center;gap:30px;font-size:11px}.header-nav a{text-decoration:none}.header-nav>a:hover{color:var(--gold)}.header-nav .nav-cta{padding:10px 18px;border:1px solid #e6bf7e70;border-radius:3px;color:var(--gold)}.hero{position:relative;overflow:hidden;background:var(--navy);color:var(--paper);padding:152px 0 62px}.hero:before{content:'';position:absolute;right:-3%;top:160px;width:53%;height:570px;background:radial-gradient(ellipse,#5b2d8a55,transparent 67%);pointer-events:none}.hero{background-image:linear-gradient(to bottom,transparent calc(100% - 110px),#0c061655)}.hero-grid{position:relative;z-index:1;display:grid;grid-template-columns:1.1fr .9fr;align-items:center;gap:28px}.hero .eyebrow{color:var(--gold);margin-bottom:25px;display:flex;align-items:center;gap:12px}.hero .eyebrow:before{content:'';display:block;width:24px;height:1px;background:var(--gold)}.hero h1{font-size:clamp(54px,5.2vw,74px);line-height:1.015;letter-spacing:-.045em}.hero h1 em{color:var(--gold)}.hero-copy>p{font-size:15px;max-width:480px;color:#ccc1d2;margin-top:26px;line-height:1.8}.hero-product-line{font-size:11px;line-height:1.8;color:#e3dee6;margin-top:24px;display:flex;gap:9px;align-items:flex-start}.hero-product-line .icon{color:var(--gold);margin-top:2px}.hero-actions{display:flex;flex-wrap:wrap;align-items:center;gap:22px;margin-top:30px}.hero-actions .text-link{color:#d1c5d6;font-size:11px}.hero-price{margin-top:17px;font-size:11px;color:#d1c8d7}.hero-price strong{color:var(--paper);font-weight:500}.hero-guarantee{margin-top:9px;font-size:10px;color:#b29ebc;display:flex;align-items:center;gap:7px;flex-wrap:wrap}.hero-guarantee .icon{width:13px;height:13px}.product-stage{position:relative;min-height:570px;display:flex;align-items:center;justify-content:center;isolation:isolate}.ether-orbit{position:absolute;inset:0;z-index:-2;background:linear-gradient(90deg,var(--navy),#1a0f2c22 40%,var(--navy)),linear-gradient(0deg,var(--navy),#1a0f2c00 45%,var(--navy)),url('/planners/eter/eter-textura.webp') center/cover;opacity:.36;mask-image:radial-gradient(ellipse,#000 30%,transparent 70%);-webkit-mask-image:radial-gradient(ellipse,#000 30%,transparent 70%)}.orbit{position:absolute;border:1px solid #e6bf7e20;width:440px;height:440px;border-radius:50%;transform:rotate(-25deg) scaleY(.9);z-index:-1}.orbit:after{content:'';position:absolute;width:390px;height:390px;border:1px solid #e6bf7e12;border-radius:50%;top:24px;left:24px}.product-cover{width:300px;position:relative;transform:perspective(1200px) rotateY(-10deg) rotateZ(3deg);filter:drop-shadow(18px 23px 24px #0009);border-radius:1px;outline:1px solid #ffffff20}.product-cover:after{content:'';position:absolute;left:0;top:0;bottom:0;width:9px;background:linear-gradient(90deg,#fff3,#0004,transparent);pointer-events:none}.product-cover img{width:100%;border-radius:1px}.day-seal{position:absolute;right:3px;top:20px;width:102px;height:102px;display:flex;align-items:center;justify-content:center;flex-direction:column;text-align:center;border:1px solid #e6bf7e7a;border-radius:50%;background:var(--navy);color:var(--gold);box-shadow:0 0 0 6px var(--navy),0 0 0 7px #e6bf7e22}.day-seal strong{font-family:var(--serif);font-size:42px;font-weight:400;line-height:.95}.day-seal span{font-size:8px;letter-spacing:.13em;line-height:1.5;text-transform:uppercase;margin-top:6px}.product-caption{position:absolute;bottom:0;left:0;right:0;text-align:center;color:#b7a4bf;font-size:9px;letter-spacing:.04em}.product-caption:before{content:'';height:32px;width:1px;background:#e6bf7e60;display:block;margin:0 auto 12px}.hero-bottom{position:relative;z-index:1;display:flex;justify-content:space-between;gap:26px;margin-top:44px;border-top:1px solid #ffffff1c;padding-top:24px;font-size:10px;color:#cabed1}.hero-bottom>div{display:flex;gap:11px;align-items:center}.hero-bottom strong{font-family:var(--serif);font-weight:400;font-size:26px;color:var(--gold);line-height:1}.hero-bottom .fine{font-size:9px;max-width:205px;text-align:right;color:#a892b1}.scroll-note{font-size:9px;text-transform:uppercase;letter-spacing:.16em;display:flex;align-items:center;gap:12px}.scroll-note:before{content:'';height:1px;width:30px;background:#e6bf7e60}
.recognition{background:var(--paper)}.recognition-top{display:grid;grid-template-columns:1.35fr .65fr;gap:80px;align-items:end}.recognition-top>p{font-size:15px;color:var(--muted);padding-bottom:3px}.situations{display:grid;grid-template-columns:repeat(3,1fr);gap:38px;margin-top:54px}.situation{padding-top:22px;border-top:1px solid var(--line)}.situation-no{font-family:var(--serif);font-size:17px;color:var(--gold-dark);display:block;margin-bottom:16px}.situation h3{font-size:29px;margin-bottom:17px;line-height:1.15}.situation p{font-size:13px;color:var(--muted);line-height:1.8}.gentle-line{display:flex;gap:28px;align-items:center;margin-top:54px;font-family:var(--serif);font-size:26px;color:var(--blue)}.gentle-line:before{content:'';width:55px;height:1px;background:var(--gold-dark);flex-shrink:0}
.method{background:#ede9e1;padding:85px 0}.method-intro{display:grid;grid-template-columns:1fr 1fr;align-items:end;gap:90px}.method-intro p{font-size:14px;color:var(--muted)}.elements{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin-top:42px}.element{padding:26px 18px 24px;border:1px solid #3c214921;min-height:165px;position:relative;background:#ffffff1f}.element svg{width:30px;height:30px;color:#8b7760;display:block;margin-bottom:15px;stroke-width:1.15}.element h3{font-size:27px;margin-bottom:8px}.element p{font-size:11px;color:var(--muted);line-height:1.7}.element.active{background:var(--navy);color:var(--paper);border-color:var(--navy);box-shadow:0 12px 30px #30193a1a;transform:translateY(-8px)}.element.active svg{color:var(--gold)}.element.active p{color:#cebdd6}.element-active-label{position:absolute;right:12px;top:14px;font-size:7px;letter-spacing:.12em;color:var(--gold);text-transform:uppercase}.method-foot{display:flex;gap:25px;justify-content:space-between;align-items:flex-start;margin-top:28px}.method-foot>p{font-size:13px;max-width:730px}.method-foot>span{font-size:9px;line-height:1.7;max-width:255px;color:#796f7e}.method-foot strong{font-weight:600}
.sample{background:var(--white)}.sample-grid{display:grid;grid-template-columns:.88fr 1.12fr;gap:92px;align-items:center}.sample-description>p{font-size:14px;line-height:1.85;color:var(--muted);margin-top:24px}.sample-description .text-link{display:inline-flex;align-items:center;gap:12px;margin-top:28px;color:var(--ink)}.sample-description .eyebrow{margin-bottom:22px;color:var(--gold-dark)}.mini-steps{display:flex;gap:19px;margin-top:30px;padding-top:23px;border-top:1px solid var(--line);font-size:10px;color:var(--muted)}.mini-steps span{display:flex;align-items:center;gap:6px}.mini-steps .icon{width:16px;height:16px;color:var(--gold-dark)}.sample-frame{background:var(--paper);border:1px solid #e1d9cd;padding:15px 30px 25px;position:relative;box-shadow:0 18px 50px #2d103a0a}.sample-frame:before{content:'';position:absolute;left:13px;right:13px;bottom:-8px;height:8px;background:#ece6db;border:1px solid #ded5c7;border-top:0}.sample-tabs{display:flex;gap:10px;padding-bottom:15px;border-bottom:1px solid var(--line);margin-bottom:27px}.sample-tabs button{flex:1;padding:9px 7px;border:1px solid transparent;border-radius:2px;background:transparent;color:var(--muted);font-size:10px;line-height:1.5}.sample-tabs button small{display:block;text-transform:uppercase;font-size:8px;letter-spacing:.1em}.sample-tabs button[aria-selected=true]{background:var(--navy);color:var(--paper)}.sample-panel .eyebrow{color:var(--gold-dark);font-size:8px;letter-spacing:.15em;margin-bottom:13px}.sample-panel h3{font-size:34px;margin-bottom:25px}.sample-panel blockquote{font-family:var(--serif);font-size:26px;line-height:1.35;color:var(--ink);min-height:151px}.reflection{margin-top:25px;padding-top:20px;border-top:1px solid var(--line)}.reflection span{font-size:8px;letter-spacing:.17em;color:var(--gold-dark);text-transform:uppercase}.reflection p{font-family:var(--serif);font-size:22px;margin-top:7px}.writing-lines{height:44px;margin-top:15px;background:repeating-linear-gradient(to bottom,transp