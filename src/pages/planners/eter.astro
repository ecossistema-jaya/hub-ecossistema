.journey{background:var(--navy);color:var(--paper);position:relative;overflow:hidden}.journey-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:95px;align-items:start}.journey .section-intro .eyebrow{color:var(--gold)}.journey .section-intro p{color:#c8bacf;font-size:14px;line-height:1.85}.journey .journey-note{margin-top:34px;max-width:320px;font-family:var(--serif);font-size:27px;color:var(--gold);line-height:1.2}.weekly{border-top:1px solid #ffffff25}.weekly details{border-bottom:1px solid #ffffff25}.weekly summary{list-style:none;display:grid;grid-template-columns:34px 1fr 20px;gap:17px;align-items:center;cursor:pointer;padding:24px 0}.weekly summary::-webkit-details-marker{display:none}.weekly-num{font-family:var(--serif);font-size:22px;color:var(--gold);align-self:start;padding-top:4px}.weekly-tag{font-size:8px;letter-spacing:.14em;text-transform:uppercase;color:#b099bb;display:block;margin-bottom:8px}.weekly-title{font-family:var(--serif);font-size:28px;line-height:1.1;display:block}.plus{position:relative;width:16px;height:16px;display:block}.plus:before,.plus:after{content:'';position:absolute;left:0;top:7px;width:14px;height:1px;background:currentColor}.plus:after{transform:rotate(90deg);transition:transform .2s}details[open] .plus:after{transform:rotate(0)}.weekly-content{padding:0 36px 25px 51px}.weekly-content p{font-size:12px;color:#cebcd6}.practice-tags{display:flex;flex-wrap:wrap;gap:7px;margin-top:17px}.practice-tags span{font-size:9px;color:#e2dae6;border:1px solid #e6dbed26;border-radius:2px;padding:5px 8px}.journey-note-small{color:#a990b3;font-size:9px;margin-top:20px;max-width:485px}
