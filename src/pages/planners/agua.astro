 const mobile=document.querySelector('.mobile-buy'),mobileLink=mobile.querySelector('a'),heroCTA=document.getElementById('hero-cta'),offer=document.getElementById('oferta'),closing=document.querySelector('.closing'),progress=document.querySelector('.progress');
