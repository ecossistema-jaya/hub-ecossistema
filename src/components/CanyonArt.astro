---
/**
 * Placeholder art used when a real photo is missing: a canyon at sunset in brand colors.
 * Pure SVG, themed through CSS custom properties, so it costs no request.
 */
interface Props {
  variant?: 'hero' | 'shakti' | 'jaya-ai';
  class?: string;
}
const { variant = 'hero', class: className } = Astro.props;
const id = `canyon-${variant}`;
---

<svg
  class:list={['canyon', `canyon--${variant}`, className]}
  viewBox="0 0 400 500"
  preserveAspectRatio="xMidYMid slice"
  role="img"
  aria-label="Ilustração de um cânion ao pôr do sol"
>
  <defs>
    <linearGradient id={`${id}-sky`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="var(--art-sky-top)"></stop>
      <stop offset="0.62" stop-color="var(--art-sky-low)"></stop>
    </linearGradient>
    <radialGradient id={`${id}-sun`} cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="var(--art-sun)"></stop>
      <stop offset="1" stop-color="var(--art-sun)" stop-opacity="0"></stop>
    </radialGradient>
  </defs>
  <rect width="400" height="500" fill={`url(#${id}-sky)`}></rect>
  <circle cx={variant === 'jaya-ai' ? 110 : 270} cy="250" r="150" fill={`url(#${id}-sun)`} opacity="0.55"></circle>
  <circle cx={variant === 'jaya-ai' ? 110 : 270} cy="250" r="34" fill="var(--art-sun)"></circle>
  <path d="M0 300 L40 300 L52 268 L120 268 L132 300 L190 300 L204 250 L262 250 L270 214 L330 214 L338 250 L400 250 L400 500 L0 500 Z" fill="var(--art-far)"></path>
  <path d="M0 360 L70 360 L84 318 L150 318 L166 350 L240 350 L256 300 L300 300 L318 336 L400 336 L400 500 L0 500 Z" fill="var(--art-mid)"></path>
  <path d="M0 420 Q120 392 210 412 T400 400 L400 500 L0 500 Z" fill="var(--art-near)"></path>
</svg>

<style>
  .canyon {
    width: 100%;
    height: 100%;
    --art-sky-top: oklch(0.9 0.04 70);
    --art-sky-low: oklch(0.82 0.09 52);
    --art-sun: oklch(0.93 0.1 75);
    --art-far: oklch(0.66 0.1 40);
    --art-mid: oklch(0.5 0.12 34);
    --art-near: oklch(0.34 0.08 32);
  }
  .canyon--jaya-ai {
    --art-sky-low: oklch(0.84 0.06 70);
    --art-far: oklch(0.7 0.06 62);
    --art-mid: oklch(0.55 0.07 55);
    --art-near: oklch(0.36 0.05 50);
  }
  :global([data-theme='dark']) .canyon {
    --art-sky-top: oklch(0.2 0.03 330);
    --art-sky-low: oklch(0.42 0.13 30);
    --art-sun: oklch(0.72 0.16 45);
    --art-far: oklch(0.3 0.07 30);
    --art-mid: oklch(0.22 0.05 28);
    --art-near: oklch(0.14 0.02 28);
  }
</style>
