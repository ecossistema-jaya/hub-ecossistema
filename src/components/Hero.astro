---
import { Picture } from 'astro:assets';
import { hub } from '../lib/links';
import { photo } from '../lib/photos';
import CanyonArt from './CanyonArt.astro';
import Botanical from './Botanical.astro';
import Icon from './Icon.astro';

const hero = photo('hero');
const heroDark = photo('hero-dark');
const sizes = '(min-width: 960px) 440px, 78vw';
const widths = [360, 540, 720, 940];
---

<section class="hero intro" aria-labelledby="hero-title">
  <div class="hero__inner wrap">
    <div class="hero__copy">
      <p class="hero__hello fade-in" style="--i:0">Olá,</p>
      <h1 id="hero-title" class="hero__title">
        <span class="line"><span style="--i:0">Que bom</span></span>
        <span class="line"><span style="--i:1">ver você aqui.</span></span>
      </h1>
      <p class="hero__lede fade-in" style="--i:1">{hub.person.lede}</p>
      <p class="hero__role caps fade-in" style="--i:2">{hub.person.role}</p>
      <a class="hero__cue fade-in" style="--i:3" href="#caminhos">
        <span>Escolha seu caminho</span>
        <Icon name="arrow-down" size={18} />
      </a>
    </div>

    <div class="hero__visual">
      <div class="hero__sun sun-rise" aria-hidden="true"></div>
      <figure class="hero__photo photo-reveal">
        {
          hero ? (
            <Picture
              class:list={['hero__img', { 'hero__img--light': heroDark }]}
              src={hero}
              width={940}
              height={1175}
              fit="cover"
              position="top"
              formats={['avif', 'webp']}
              fallbackFormat="jpg"
              widths={widths}
              sizes={sizes}
              alt={`Retrato de ${hub.person.name}`}
              loading="eager"
              fetchpriority="high"
            />
          ) : (
            <CanyonArt variant="hero" class="hero__img" />
          )
        }
        {
          heroDark && (
            <Picture
              class="hero__img hero__img--dark"
              src={heroDark}
              width={940}
              height={1175}
              fit="cover"
              position="top"
              formats={['avif', 'webp']}
              fallbackFormat="jpg"
              widths={widths}
              sizes={sizes}
              alt=""
              loading="lazy"
            />
          )
        }
      </figure>
      <p class="hero__vertical caps" aria-hidden="true">Mais humano. Mais possível.</p>
      <Botanical class="hero__branch" />
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: min(100svh, 980px);
    display: grid;
    align-items: center;
    padding-top: calc(76px + env(safe-area-inset-top, 0px));
    padding-bottom: 48px;
  }
  .hero__inner {
    display: grid;
    gap: 36px;
    align-items: center;
  }
  .hero__hello {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--ink-soft);
    margin-bottom: 6px;
  }
  .hero__title {
    font-size: clamp(2.9rem, 12.5vw, 5.6rem);
    line-height: 0.98;
    letter-spacing: -0.025em;
  }
  .hero__lede {
    margin-top: 22px;
    max-width: 30ch;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.15rem, 4.4vw, 1.45rem);
    line-height: 1.35;
    color: var(--ink-soft);
  }
  .hero__role {
    margin-top: 18px;
    color: var(--muted);
    letter-spacing: 0.22em;
  }
  .hero__cue {
    margin-top: 30px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 0 20px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: 0.95rem;
    transition: background-color 0.3s, border-color 0.3s;
  }
  .hero__cue:hover { background: var(--accent-soft); border-color: var(--accent); }
  .hero__cue :global(svg) { transition: transform 0.3s var(--ease-out); }
  .hero__cue:hover :global(svg) { transform: translateY(3px); }

  .hero__visual {
    position: relative;
    justify-self: center;
    width: min(78vw, 440px);
    isolation: isolate;
  }
  .hero__photo {
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-arch);
    overflow: hidden;
    background: var(--surface-2);
    isolation: isolate;
  }
  .hero__photo :global(.hero__img),
  .hero__photo :global(.hero__img img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__photo :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .hero__photo :global(.hero__img--dark) { display: none; }
  :global([data-theme='dark']) .hero__photo :global(.hero__img--dark) { display: block; }
  :global([data-theme='dark']) .hero__photo :global(.hero__img--light) { display: none; }

  .hero__sun {
    position: absolute;
    width: 78%;
    aspect-ratio: 1;
    right: -26%;
    top: -12%;
    border-radius: 50%;
    background: radial-gradient(circle, var(--sun-core) 0 34%, color-mix(in oklch, var(--sun-core) 45%, transparent) 50%, transparent 70%);
    z-index: -1;
  }
  .hero__vertical {
    position: absolute;
    right: -34px;
    top: 10%;
    writing-mode: vertical-rl;
    font-size: 0.64rem;
    color: var(--muted);
    display: none;
  }
  :global(.botanical.hero__branch) {
    position: absolute;
    left: -18%;
    bottom: -10%;
    width: 34%;
    max-width: 150px;
  }

  @media (min-width: 900px) {
    .hero__inner { grid-template-columns: 1.1fr 0.9fr; gap: 64px; }
    .hero__visual { justify-self: end; }
    .hero__vertical { display: block; }
  }
</style>
