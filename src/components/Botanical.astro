---
/** Line-drawn botanical branch (mockup motif). Draws itself on scroll via .draw + pathLength=1. */
interface Props {
  class?: string;
  flip?: boolean;
}
const { class: className, flip = false } = Astro.props;
---

<svg
  class:list={['botanical', 'draw', className, { flip }]}
  viewBox="0 0 160 260"
  fill="none"
  stroke="currentColor"
  stroke-width="1.1"
  stroke-linecap="round"
  aria-hidden="true"
>
  <path pathLength="1" d="M80 258C82 200 78 140 92 80 100 46 112 22 126 4"></path>
  <path pathLength="1" d="M84 214c-22-6-40-22-50-44 22 2 40 16 50 44Z"></path>
  <path pathLength="1" d="M84 214c-10-18-12-36-8-50"></path>
  <path pathLength="1" d="M86 170c20-10 42-12 60-4-16 12-38 14-60 4Z"></path>
  <path pathLength="1" d="M86 170c18-2 34 0 48-2"></path>
  <path pathLength="1" d="M90 128c-20-10-32-28-36-50 20 8 32 26 36 50Z"></path>
  <path pathLength="1" d="M90 128c-8-14-12-28-12-40"></path>
  <path pathLength="1" d="M98 88c16-14 34-20 52-18-12 14-30 20-52 18Z"></path>
  <path pathLength="1" d="M108 50c-12-12-18-26-18-42 14 10 20 24 18 42Z"></path>
</svg>

<style>
  .botanical {
    color: var(--line-strong);
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .flip {
    transform: scaleX(-1);
  }
</style>
