---
import { hub, track } from '../lib/links';
import Icon from './Icon.astro';

const { elements } = hub;
const quiz = hub.worlds.find((w) => w.id === 'shakti')!.primary;
---

<section class="elements" aria-labelledby="elements-title">
  <div class="wrap">
    <header class="elements__head" data-reveal>
      <p class="caps elements__kicker">Método dos 5 Elementos</p>
      <h2 id="elements-title" class="elements__title">{elements.title}</h2>
      <p class="elements__summary">
        {elements.summary}
        <a class="elements__quiz" href={track(quiz.url, 'elements-quiz')}>Ainda não sabe o seu? Faça o quiz.</a>
      </p>
    </header>
  </div>

  <ul class="elements__rail" role="list" aria-label="Planners">
    {
      elements.items.map((item, i) => (
        <li class="elements__item" style={`--el: var(--${item.token}); --i:${i}`}>
          <a class="planner" href={track(item.url, item.id)}>
            <span class="planner__glyph">
              <Icon name={item.token} size={30} />
            </span>
            <span class="planner__name">{item.name}</span>
            <span class="planner__theme">{item.theme}</span>
            <span class="planner__foot">
              <span>Planner · {elements.price}</span>
              <Icon name="arrow" size={16} />
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .elements {
    padding-block: clamp(72px, 12vw, 128px) 24px;
    content-visibility: auto;
    contain-intrinsic-size: auto 620px;
  }
  .elements__kicker { color: var(--accent); letter-spacing: 0.24em; font-size: 0.68rem; }
  .elements__title {
    margin-top: 12px;
    font-size: clamp(2.2rem, 8.5vw, 3.6rem);
    max-width: 14ch;
  }
  .elements__summary {
    margin-top: 14px;
    color: var(--ink-soft);
    max-width: 52ch;
  }
  .elements__quiz {
    display: inline-block;
    margin-left: 4px;
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    padding-block: 10px; /* taller touch target without moving the text */
    margin-block: -10px;
  }

  .elements__rail {
    list-style: none;
    margin: 32px 0 0;
    padding: 4px var(--gutter) 20px;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(200px, 62vw);
    gap: 14px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .elements__rail::-webkit-scrollbar { display: none; }
  .elements__item { scroll-snap-align: start; }

  .planner {
    position: relative;
    height: 100%;
    min-height: 230px;
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: 6px;
    padding: 20px 18px 16px;
    border-radius: var(--radius-lg);
    background: color-mix(in oklch, var(--surface) 90%, var(--el) 10%);
    border: 1px solid color-mix(in oklch, var(--line) 70%, var(--el) 30%);
    overflow: hidden;
    transition: transform 0.45s var(--ease-out), border-color 0.3s;
  }
  .planner::before {
    content: '';
    position: absolute;
    width: 180px;
    aspect-ratio: 1;
    right: -70px;
    top: -70px;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in oklch, var(--el) 35%, transparent), transparent 70%);
    transition: transform 0.8s var(--ease-out);
  }
  .planner:active { transform: scale(0.98); }
  @media (hover: hover) and (pointer: fine) {
    .planner:hover { transform: translateY(-4px); border-color: var(--el); }
    .planner:hover::before { transform: scale(1.35); }
  }
  .planner__glyph {
    width: 52px;
    height: 52px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: var(--el);
    border: 1px solid color-mix(in oklch, var(--el) 45%, transparent);
    margin-bottom: 14px;
  }
  :global([data-theme='dark']) .planner__glyph { color: color-mix(in oklch, var(--el) 60%, white); }
  .planner__name { font-family: var(--font-display); font-size: 1.9rem; line-height: 1; }
  .planner__theme { color: var(--ink-soft); font-size: 0.95rem; }
  .planner__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    font-size: 0.82rem;
    color: var(--muted);
  }

  /* Scroll-driven: cards ease in as they slide into the rail's viewport. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view(inline)) {
      .elements__item {
        animation: card-in linear both;
        animation-timeline: view(inline);
        animation-range: entry 0% entry 80%;
      }
    }
  }
  @keyframes card-in {
    from { opacity: 0.35; transform: scale(0.94); }
    to { opacity: 1; transform: none; }
  }

  @media (min-width: 900px) {
    .elements__rail {
      grid-auto-flow: row;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      overflow: visible;
      max-width: var(--maxw);
      margin-inline: auto;
      padding-inline: var(--gutter);
    }
    .elements__item { animation: none; }
  }
</style>
