---
import { hub, track } from '../lib/links';
import Icon from './Icon.astro';
import Botanical from './Botanical.astro';
import Compass from './Compass.astro';

const year = new Date().getFullYear();
---

<section class="quote" aria-label="Citação">
  <div class="wrap quote__inner">
    <Botanical class="quote__branch" flip />
    <figure data-reveal>
      <span class="quote__mark" aria-hidden="true">“</span>
      <blockquote class="quote__text">
        <p>Disciplina também é uma forma de amor próprio.</p>
      </blockquote>
      <figcaption class="tracked quote__by">{hub.person.name}</figcaption>
    </figure>
  </div>
</section>

<footer class="footer">
  <Compass class="footer__compass" size={260} />
  <div class="wrap footer__inner">
    <span class="footer__logo" role="img" aria-label="Jaya"></span>
    <p class="footer__wordmark" aria-hidden="true">Jaya Roberta</p>
    <p class="footer__tag">Entre Mundos · Inteligência Relacional</p>
    <a class="footer__about" href="/sobre">Sobre a Jaya</a>

    <nav aria-label="Redes sociais">
      <ul class="footer__social" role="list">
        {
          hub.social.map((s) => (
            <li>
              <a
                target="_blank"
                rel="noopener"
                class:list={[{ 'is-accent': 'accent' in s && s.accent }]}
                href={track(s.url, s.id)}
                data-link={s.id}
                aria-label={s.label}
                title={s.label}
              >
                <Icon name={s.icon} size={20} />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="footer__actions">
      <button class="footer__btn" type="button" data-share data-status="share-status">
        <Icon name="share" size={16} />
        Compartilhar
      </button>
      <button class="footer__btn" type="button" data-theme-toggle aria-label="Alternar tema escuro">
        <Icon name="moon" size={16} />
        Tema
      </button>
    </div>
    <p id="share-status" class="footer__status" role="status" aria-live="polite"></p>

    <details class="footer__restricted">
      <summary><Icon name="lock" size={13} /> Área restrita</summary>
      <ul role="list">
        {hub.restricted.map((r) => (
          <li><a href={r.url} data-link={r.id} target="_blank" rel="nofollow noopener">{r.label}</a></li>
        ))}
      </ul>
    </details>

    <p class="footer__legal">
      <span>Conhecimento em movimento</span>
      <span aria-hidden="true">—</span>
      <span>© {year} {hub.person.name} · {hub.person.location}</span>
    </p>
  </div>
</footer>

<style>
  .quote {
    padding-block: clamp(80px, 12vw, 130px);
    content-visibility: auto;
    contain-intrinsic-size: auto 460px;
  }
  .quote__inner { position: relative; display: grid; justify-items: center; text-align: center; }
  :global(.botanical.quote__branch) {
    position: absolute;
    right: max(0px, calc(50% - 380px));
    top: -40px;
    width: 110px;
  }
  .quote__mark {
    display: block;
    font-family: var(--font-display);
    font-size: 4rem;
    line-height: 0.6;
    color: var(--rust);
  }
  .quote__text { margin: 14px 0 0; }
  .quote__text p {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 7vw, 3rem);
    line-height: 1.2;
    max-width: 17ch;
    color: var(--ink);
  }
  .quote__by { margin-top: 22px; }

  /* SAND footer: teal-deep panel, constellation texture, giant tracked wordmark */
  .footer {
    --f-bg: #0f2e3a;
    --f-ink: #f6f5f0;
    --f-muted: #9fb3ba;
    --f-gold: #f4cf85;
    position: relative;
    overflow: hidden;
    padding: 72px 0 calc(40px + env(safe-area-inset-bottom, 0px));
    background:
      radial-gradient(circle at 20% 30%, rgba(244, 207, 133, 0.5) 0 1px, transparent 1.5px) 0 0 / 90px 90px,
      radial-gradient(circle at 70% 60%, rgba(244, 207, 133, 0.35) 0 1px, transparent 1.5px) 0 0 / 130px 130px,
      var(--f-bg);
    color: var(--f-ink);
    content-visibility: auto;
    contain-intrinsic-size: auto 620px;
  }
  :global([data-theme='dark']) .footer { --f-bg: #061519; }
  :global(.compass.footer__compass) {
    position: absolute;
    right: -70px;
    top: -60px;
    color: var(--f-gold);
    opacity: 0.18;
  }
  .footer__inner { position: relative; display: grid; justify-items: center; gap: 18px; text-align: center; }
  .footer__logo {
    width: 84px;
    height: 84px;
    background: var(--f-gold);
    -webkit-mask: url('/brand/logo-symbol.webp') center / contain no-repeat;
    mask: url('/brand/logo-symbol.webp') center / contain no-repeat;
  }
  .footer__wordmark {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 6vw, 2.6rem);
    letter-spacing: 0.5em;
    text-indent: 0.5em;
    text-transform: uppercase;
    line-height: 1.2;
  }
  .footer__tag { max-width: 36ch; color: var(--f-muted); font-size: 0.95rem; }
  .footer__about {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 4px;
    border-bottom: 1px solid rgba(244, 207, 133, 0.45);
    color: var(--f-gold);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    transition: border-color var(--t-fast);
  }
  @media (hover: hover) {
    .footer__about:hover { border-bottom-color: var(--f-gold); }
  }

  .footer__social { list-style: none; margin: 8px 0 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
  .footer__social a {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid rgba(246, 245, 240, 0.28);
    color: var(--f-ink);
    transition: background-color var(--t-fast), color var(--t-fast), border-color var(--t-fast);
  }
  /* A second account on the same network (e.g. @jayaroberta.ai) is told apart by colour. */
  .footer__social a.is-accent { color: var(--f-gold); border-color: var(--f-gold); }
  @media (hover: hover) {
    .footer__social a:hover { background: var(--f-gold); color: var(--f-bg); border-color: var(--f-gold); }
  }

  .footer__actions { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; }
  .footer__btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 18px;
    background: transparent;
    border: 1px solid rgba(246, 245, 240, 0.35);
    color: var(--f-ink);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color var(--t-fast), color var(--t-fast);
  }
  @media (hover: hover) {
    .footer__btn:hover { background: #fcb655; color: #0a2229; border-color: #fcb655; }
  }
  .footer__status { min-height: 1.2em; font-size: 0.85rem; color: var(--f-muted); }

  .footer__restricted { font-size: 0.85rem; color: var(--f-muted); }
  .footer__restricted summary {
    cursor: pointer;
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding-inline: 8px;
  }
  .footer__restricted summary::-webkit-details-marker { display: none; }
  .footer__restricted ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 8px; justify-content: center; }
  .footer__restricted a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 12px;
    color: var(--f-ink);
    border-bottom: 1px solid rgba(246, 245, 240, 0.3);
  }

  .footer__legal {
    margin-top: 10px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 12px;
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--f-muted);
  }
</style>
